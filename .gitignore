# Data payloads never enter git: raw listings may still carry seller traces,
# and the processed sets are reproducible from the scripts.
data/**
!data/**/
!data/**/.gitkeep
*.jsonl
*.parquet
*.csv
!reports/tables/*.csv

# Model artefacts
models/*.joblib
models/*.pkl
artifacts/

# Geocoding cache
.cache/
*.sqlite

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Secrets and local config
.env
config/local.yaml

# OS
.DS_Store

# Bản build của báo cáo (sinh lại bằng scripts/build-docx.sh); bản cuối nằm trong submission/
reports/bao-cao-khoa-hoc.docx
reports/bao-cao-khoa-hoc.pdf
reports/technical-report/technical-report.docx
reports/slides/slides.pptx

# Bản đã ghép bảng vào chương (sinh lại bằng scripts/assemble-report.py)
reports/scientific-report/_built/
reports/slides/_built/

# Thư mục nộp được ráp lại bằng scripts/assemble-submission.py.
# Dấu ngoặc vuông phải escape: git đọc [...] là character class, nên pattern không
# escape sẽ khớp một ký tự bất kỳ trong tập đó thay vì khớp dấu ngoặc literal, và
# toàn bộ thư mục 9 MB lọt vào git.
submission/\[Project AI-UIT\]*/
